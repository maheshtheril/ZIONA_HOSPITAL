# Production Database (Neon Vercel Integration)
# Use the pooled connection string for DATABASE_URL (has ?pgbouncer=true or similar)
DATABASE_URL="postgresql://user:password@neon-host/dbname?sslmode=require&pgbouncer=true"

# Use the direct connection string for Migrations
DIRECT_DATABASE_URL="postgresql://user:password@neon-host/dbname?sslmode=require"

# Vercel Deployment URL
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# App Branding
NEXT_PUBLIC_APP_BRAND="Your Brand Name"

# Auth Secrets - Generate via `openssl rand -base64 32` or Vercel UI
AUTH_SECRET="your-generated-secret-key"
NEXTAUTH_SECRET="your-generated-secret-key"